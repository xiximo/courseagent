# 复制为 deploy/.env 后修改。不要提交真实密钥。

# 已解析到本机公网 IP 的域名（不要带 https://）
# 需要同时支持 www 时写成：example.com, www.example.com
DOMAIN=agent.rebuilder.com.cn
# 浏览器来源，须带 https://；多个用逗号分隔
CORS_ORIGINS=https://agent.rebuilder.com.cn

# Let's Encrypt / ZeroSSL 到期提醒邮箱
ACME_EMAIL=admin@rebuilder.com.cn

# 宿主机向量模型目录（挂到容器 /app/models）
EMBEDDING_MODELS_DIR=./models

# PostgreSQL（compose 内置库）
POSTGRES_PASSWORD=change-me-strong-db-password

# JWT，生产环境务必换成随机长字符串：openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# 可选：国内拉不动官方镜像时保持默认；能访问 Docker Hub 可改成官方名
# POSTGRES_IMAGE=postgres:16-alpine
# CADDY_IMAGE=caddy:2.9-alpine
